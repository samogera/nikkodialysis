# Copy to Vercel → Project → Settings → Environment Variables. Never commit real values.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
ENQUIRY_TO=reception@your-domain.co.ke
ENQUIRY_FROM="Nikko Website <website@your-domain.co.ke>"
# Optional: also POST each enquiry as JSON to a webhook (Google Apps Script, Zapier, Slack, CRM)
ENQUIRY_WEBHOOK_URL=
# Optional: comma-separated extra allowed origins for the API (your domain is allowed automatically)
ALLOWED_ORIGINS=
